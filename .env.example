# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ── Anthropic ─────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the default model (default: claude-opus-4-7)
# ANTHROPIC_MODEL=claude-opus-4-7

# ── Google Services ───────────────────────────────────────────────
# Enable "Civic Information API" at https://console.cloud.google.com
# Server-side only — never expose this key to the client
GOOGLE_CIVIC_API_KEY=your_google_civic_api_key_here

# Enable "Maps JavaScript API" at https://console.cloud.google.com
# Server-side key (unrestricted) — for server-side geocoding
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Client-safe Maps key — restrict to your domain in Google Cloud Console
# This key IS exposed to the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_restricted_maps_key_here

# ── App ───────────────────────────────────────────────────────────
# Set to your production URL when deploying
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
