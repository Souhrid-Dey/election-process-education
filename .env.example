# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ── Google AI (Vertex AI / Gemini) ────────────────────────────────
# Enable "Vertex AI API" in Google Cloud Console, then generate key
# Server-side only — never expose to the client
GEMINI_API_KEY=your_gemini_api_key_here

# Your Google Cloud project ID (needed for Vertex AI and Cloud Run)
GCP_PROJECT_ID=your_gcp_project_id_here

# ── Google Services ───────────────────────────────────────────────
# Enable "Civic Information API" at https://console.cloud.google.com
# Server-side only
GOOGLE_CIVIC_API_KEY=your_google_civic_api_key_here

# Enable "Maps JavaScript API" at https://console.cloud.google.com
# Server-side key (for geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Client-safe Maps key — restrict to your domain in Google Cloud Console
# Safe to expose (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_restricted_maps_key_here

# ── App ───────────────────────────────────────────────────────────
# Set to your Cloud Run service URL when deployed
# NEXT_PUBLIC_APP_URL=https://your-service-xxxx-uc.a.run.app
